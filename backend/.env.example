# LLM-Quant backend configuration
# Copy this file to .env and fill in the values you need.
#
# Paper trading (the DEFAULT) needs NO credentials at all — leave everything below
# unset and the bot reads Polymarket's PUBLIC market data + simulates fills. The
# variables here become relevant when you DEPLOY (auth + CORS) or go LIVE (venue keys
# + caps). Every var is read by backend/app/config.py; the deploy guide
# (docs/DEPLOYMENT.md §2) and the live runbook (docs/growth/LIVE_RUNBOOK.md §4) are
# the canonical references. Server-side only — never commit a filled-in .env.

# ============ LLM (Google Gemini) ============
# Optional — powers AI analysis/commentary. Without it, those features fall back to
# templates. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash). Set a newer model id here
# without any code change, e.g. GEMINI_MODEL=gemini-2.5-pro
# GEMINI_MODEL=gemini-2.5-flash

# ============ Database ============
# Default (local dev): SQLite — leave DATABASE_URL unset.
# Production: Neon Postgres. Get the string from the Neon Console ->
#   your project -> Connection Details -> copy the connection string.
#
# Use the POOLED connection string (host has "-pooler"); it handles Neon's
# autosuspend/reconnect well for a persistent backend. The string already includes
# ?sslmode=require — keep it. Example:
#   DATABASE_URL=postgresql://[USER]:[PASSWORD]@ep-xxxx-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require
# The direct (non-pooled) endpoint also works. Any Postgres URL is fine — the engine
# is dialect-aware (pool_pre_ping handles dropped idle connections; sslmode=require is
# added automatically only if the URL doesn't already specify it).
# DATABASE_URL=

# ============ Deploy: server / CORS ============
# Extra allowed CORS origins for a deployed frontend (comma-separated exact origins,
# scheme+host, NO trailing slash). Localhost dev origins are always allowed. Set this
# to your Vercel origin AFTER the frontend deploy, e.g.:
#   CORS_ALLOW_ORIGINS=https://llm-quant.vercel.app
# CORS_ALLOW_ORIGINS=
# Demo mode uses fallback data when external APIs are unavailable. Default true.
# DEMO_MODE=true

# ============ Backend control-route auth (required on a PUBLIC deploy) ============
# The state-mutating control routes (kill-switch, execute, bot start/stop/scan, risk
# config, portfolio reset) are DEFAULT-CLOSED (since #129): with NO token set they DENY
# with 401 — a public deploy that forgets this is NOT silently unauthenticated.
# On a public deploy, set a random secret and inject it server-side from the frontend
# (never NEXT_PUBLIC_*). See docs/DEPLOYMENT.md §2 + PENDING_OPS OA-14.
#   BACKEND_API_TOKEN=$(openssl rand -hex 32)
# BACKEND_API_TOKEN=
# Dev/paper opt-out INSTEAD of a token: set 1 to run the control routes OPEN on a
# trusted single-user host. It can NEVER be active with real money — the app HARD-REFUSES
# to boot if this is set while LIVE_TRADING_ENABLED=true. Omit on a public deploy.
# BACKEND_AUTH_DISABLED=0

# ============ HARD caps + spend ceilings (USD) — set BEFORE any live capability ============
# OA-1 / LIVE_RUNBOOK §4. The code defaults (shown) are conservative; set your real
# ceilings before going live. The kill switch trips on breach — verify with the runtime
# harness that no further orders are placed once a cap trips.
# MAX_PER_TRADE_USD=5.0     # hard cap on any single order notional
# MAX_DAILY_LOSS_USD=25.0   # auto-trip kill switch if daily net loss exceeds this
# MAX_TOTAL_LOSS_USD=100.0  # auto-trip kill switch if cumulative net loss exceeds this
# LLM_SPEND_CAP_USD=20.0    # cap on model/provider spend (research + factory)

# ============ REAL-MONEY MASTER GATE (HUMAN-CORE — owner only) ============
# The master switch that allows real orders. DEFAULT false (paper-only). With this
# false, no real order can be placed regardless of any other setting. Flip to true ONLY
# after every LIVE_RUNBOOK step (caps verified, venue keys set, kill switch tested).
# The autonomous loop NEVER sets this. See PENDING_OPS OA-6 + LIVE_RUNBOOK §6.
# LIVE_TRADING_ENABLED=false

# ============ Unvalidated-strategy gate (default OFF — keep it off) ============
# Some strategies (whale-copy / wallet-divergence / weather) are NOT tracked in
# ROADMAP/RESEARCH_MEMORY, have no B3 registry evidence, no backtest, and no proof they
# fire correctly on real-shaped data — the whale infra once shipped a FABRICATED seed of
# "known whale" wallets (removed 2026-07-01). Per "no alpha ships while integrity is
# weak", they are kept OUT of the default paper scan. This flag (default false) is the
# gate; flip it to true ONLY to deliberately exercise those strategies — it arms trading
# on unvalidated/fabricated-edge signals in PAPER too, so leave it unset in normal use.
# The autonomous loop NEVER sets this. See the whale/weather ROADMAP items + the
# 2026-07-01 Research Run 11 integrity finding in docs/growth/RESEARCH_MEMORY.md.
# ENABLE_UNVALIDATED_STRATEGIES=false

# ============ Prediction-markets venue (LIVE trading only) ============
# Paper trading (the default) needs NO venue keys — the bot reads Polymarket's PUBLIC
# market data and simulates fills. The keys below are required ONLY when the owner
# chooses to go live (LIVE_TRADING_ENABLED=true). Server-side only, never commit them.
# See PENDING_OPS.md (OA-5/OA-6) + docs/growth/LIVE_RUNBOOK.md.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER=
