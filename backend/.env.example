# QuantLab Configuration
# Copy this to .env and optionally fill in API keys
# The app works without API keys using mock/demo data

# Database (SQLite - local file)
DATABASE_URL=sqlite:///./quantlab.db

# LLM Integration (optional - app works without it with fallback responses)
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Market Data API Keys (optional - uses fallback mock data if not set)
# Finnhub: https://finnhub.io/ (free tier available)
FINNHUB_API_KEY=

# Data Provider Settings
DATA_PROVIDER=yfinance  # Options: stooq, yfinance
DATA_CACHE_DAYS=1       # Days to cache data before refresh

# Paper Trading Settings
INITIAL_CASH=100000
DEFAULT_TRANSACTION_COST_BPS=10  # 10 basis points
DEFAULT_SLIPPAGE_BPS=5           # 5 basis points

# Risk Settings
MAX_POSITION_WEIGHT=0.10         # 10% max per position
TARGET_VOLATILITY=0.15           # 15% annualized vol target
MAX_DRAWDOWN_LIMIT=0.20          # 20% drawdown guardrail

# Demo Mode - ENABLED BY DEFAULT for easy setup
# Uses fallback data when external APIs unavailable
DEMO_MODE=true
DEMO_SEED=42

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
