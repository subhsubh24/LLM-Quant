# Broker API Credentials
# Copy this file to .env and add your API keys

# ============ LLM (Google Gemini) ============
# Optional — powers AI analysis/commentary. Without it, those features fall back to
# templates. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash). Set a newer model id here
# without any code change, e.g. GEMINI_MODEL=gemini-2.5-pro
# GEMINI_MODEL=gemini-2.5-flash

# ============ Database ============
# Default (local dev): SQLite — leave DATABASE_URL unset.
# Production: Neon Postgres. Get the string from the Neon Console ->
#   your project -> Connection Details -> copy the connection string.
#
# Use the POOLED connection string (host has "-pooler"); it handles Neon's
# autosuspend/reconnect well for a persistent backend. The string already includes
# ?sslmode=require — keep it. Example:
#   DATABASE_URL=postgresql://[USER]:[PASSWORD]@ep-xxxx-pooler.[REGION].aws.neon.tech/[DB]?sslmode=require
# The direct (non-pooled) endpoint also works. Any Postgres URL is fine — the engine
# is dialect-aware (pool_pre_ping handles dropped idle connections; sslmode=require is
# added automatically only if the URL doesn't already specify it).
# DATABASE_URL=

# Alpaca (US Stocks/ETFs) - Paper Trading
# Get keys at: https://alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
ALPACA_PAPER_MODE=true

# Binance (Crypto)
# For US users: https://www.binance.us (set BINANCE_US_MODE=true)
# For non-US: https://www.binance.com (set BINANCE_US_MODE=false)
# Testnet (paper): https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET_MODE=true
BINANCE_US_MODE=true  # Set to true for Binance.US (spot only), false for Binance Global

# ============ Alternative Data API Keys ============
# All optional - providers fall back to proxies without keys

# FRED (Federal Reserve Economic Data) - RECOMMENDED
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Takes 30 seconds to register. Unlocks 800,000+ economic time series.
FRED_API_KEY=

# Alternative data toggles (all enabled by default)
ALT_DATA_ENABLED=true
ALT_DATA_FRED_ENABLED=true
ALT_DATA_CROSS_ASSET_ENABLED=true
ALT_DATA_SENTIMENT_ENABLED=true
