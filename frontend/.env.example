# Frontend Configuration

# API URL (backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============ Password gate (REQUIRED in production) ============
# The monitoring panel shows sensitive financial data, so the whole app is gated
# behind a single shared password. Set BOTH of these in Vercel (Project Settings ->
# Environment Variables). They are server-side only and never exposed to the browser.
#
# APP_PASSWORD — the password you type to log in.
# AUTH_SECRET  — a long random string used to sign the session cookie. Generate one:
#                  openssl rand -hex 32
# If either is unset, the app refuses login and redirects to /login (fails closed).
APP_PASSWORD=change-me-to-a-strong-password
AUTH_SECRET=generate-with-openssl-rand-hex-32
